        function updateSignalStatus(rsi, stoch, macd, volume) {
            // RSI durumu
            const rsiStatus = document.getElementById('rsiStatus');
            if (rsi < 30) {
                rsiStatus.textContent = 'AŞIRI SATIM';
                rsiStatus.style.background = 'var(--success)';
                document.getElementById('rsiSignal').classList.add('active');
            } else if (rsi > 70) {
                rsiStatus.textContent = 'AŞIRI ALIM';
                rsiStatus.style.background = 'var(--danger)';
                document.getElementById('rsiSignal').classList.remove('active');
            } else {
                rsiStatus.textContent = 'NÖTR';
                rsiStatus.style.background = 'var(--warning)';
                document.getElementById('rsiSignal').classList.remove('active');
            }
            
            // Stoch durumu
            const stochStatus = document.getElementById('stochStatus');
            if (stoch < 20) {
                stochStatus.textContent = 'AL BÖLGESİ';
                stochStatus.style.background = 'var(--success)';
                document.getElementById('stochSignal').classList.add('active');
            } else if (stoch > 80) {
                stochStatus.textContent = 'SAT BÖLGESİ';
                stochStatus.style.background = 'var(--danger)';
                document.getElementById('stochSignal').classList.remove('active');
            } else {
                stochStatus.textContent = 'NÖTR';
                stochStatus.style.background = '#3b82f6';
                document.getElementById('stochSignal').classList.remove('active');
            }
            
            // MACD durumu
            const macdStatus = document.getElementById('macdStatus');
            if (macd > 0) {
                macdStatus.textContent = 'BULLISH';
                macdStatus.style.background = 'var(--success)';
                document.getElementById('macdSignal').classList.add('active');
            } else {
                macdStatus.textContent = 'BEARISH';
                macdStatus.style.background = 'var(--danger)';
                document.getElementById('macdSignal').classList.remove('active');
            }
            
            // Hacim durumu
            const volumeStatus = document.getElementById('volumeStatus');
            if (volume > 1.5) {
                volumeStatus.textContent = 'YÜKSEK';
                volumeStatus.style.background = '#8b5cf6';
                document.getElementById('volumeSignal').classList.add('active');
            } else if (volume < 0.8) {
                volumeStatus.textContent = 'DÜŞÜK';
                volumeStatus.style.background = '#6b7280';
                document.getElementById('volumeSignal').classList.remove('active');
            } else {
                volumeStatus.textContent = 'NORMAL';
                volumeStatus.style.background = '#3b82f6';
                document.getElementById('volumeSignal').classList.remove('active');
            }
            
            calculateSignalStrength(rsi, stoch, macd, volume);
        }

        function calculateSignalReliability(rsi, stoch, macd) {
            let score = 50;
            
            if (rsi < 25 || rsi > 75) score += 30;
            else if (rsi < 30 || rsi > 70) score += 20;
            else if (rsi < 35 || rsi > 65) score += 10;
            
            if (stoch < 15 || stoch > 85) score += 25;
            else if (stoch < 20 || stoch > 80) score += 15;
            else if (stoch < 25 || stoch > 75) score += 5;
            
            if (Math.abs(macd) > 100) score += 25;
            else if (Math.abs(macd) > 75) score += 15;
            else if (Math.abs(macd) > 50) score += 10;
            
            score = Math.max(0, Math.min(100, score));
            
            return Math.round(score);
        }

        function calculateSignalStrength(rsi, stoch, macd, volume) {
            let strength = 5;
            
            if (rsi < 30 || rsi > 70) strength += 2;
            else if (rsi < 35 || rsi > 65) strength += 1;
            
            if (stoch < 20 || stoch > 80) strength += 2;
            else if (stoch < 30 || stoch > 70) strength += 1;
            
            if (Math.abs(macd) > 50) strength += (macd > 0 ? 2 : -1);
            
            if (volume > 1.5) strength += 1;
            
            strength = Math.max(0, Math.min(10, strength));
            
            const strengthPercent = (strength / 10) * 100;
            document.getElementById('signalStrength').textContent = `${strength.toFixed(1)}/10`;
            document.getElementById('signalStrengthBar').style.width = `${strengthPercent}%`;
            
            const recommendation = document.getElementById('signalRecommendation');
            if (strength >= 8) {
                recommendation.textContent = '🟢 GÜÇLÜ AL SINYALİ';
                recommendation.style.color = 'var(--success)';
                document.getElementById('signalStrengthBar').style.background = 'linear-gradient(90deg, var(--success), #10b981)';
            } else if (strength >= 6) {
                recommendation.textContent = '🟡 ORTA SEVİYE SİNYAL';
                recommendation.style.color = 'var(--warning)';
                document.getElementById('signalStrengthBar').style.background = 'linear-gradient(90deg, var(--warning), #f59e0b)';
            } else if (strength >= 4) {
                recommendation.textContent = '⚪ ZAYIF SİNYAL';
                recommendation.style.color = 'var(--text-muted)';
                document.getElementById('signalStrengthBar').style.background = 'linear-gradient(90deg, #6b7280, #9ca3af)';
            } else {
                recommendation.textContent = '🔴 DİKKAT GEREKTİRİR';
                recommendation.style.color = 'var(--danger)';
                document.getElementById('signalStrengthBar').style.background = 'linear-gradient(90deg, var(--danger), #ef4444)';
            }
        }

        function updateReliabilityData(signal) {
            reliabilityData.totalSignals++;
            
            const isSuccessful = signal.reliability > 60 ? 
                (Math.random() < 0.8) : (Math.random() < 0.5);
            
            if (isSuccessful) reliabilityData.successfulSignals++;
            
            reliabilityData.reliabilityScore = Math.round(
                ((reliabilityData.reliabilityScore * (reliabilityData.totalSignals - 1)) + signal.reliability) / reliabilityData.totalSignals
            );
            
            reliabilityData.lastUpdated = new Date();
            updateReliabilityDisplay();
        }

        function updateReliabilityDisplay() {
            const reliabilityElement = document.getElementById('reliabilityRate');
            const reliabilityScore = reliabilityData.reliabilityScore;
            
            reliabilityElement.textContent = `${reliabilityScore}%`;
            
            if (reliabilityScore >= 80) {
                reliabilityElement.style.color = 'var(--success)';
            } else if (reliabilityScore >= 60) {
                reliabilityElement.style.color = 'var(--warning)';
            } else {
                reliabilityElement.style.color = 'var(--danger)';
            }
            
            if (reliabilityData.totalSignals > 0) {
                const successRate = Math.round((reliabilityData.successfulSignals / reliabilityData.totalSignals) * 100);
                document.getElementById('successRate').textContent = `${successRate}%`;
            }
        }

        function updateActiveSignals() {
