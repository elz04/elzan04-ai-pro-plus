                signalDiv.className = `signal-item ${signal.type.includes('AL') ? 'buy' : 'sell'}`;
                
                const timeDiff = Math.floor((new Date() - signal.timestamp) / 60000);
                const timeText = timeDiff < 1 ? 'Şimdi' : `${timeDiff} dk önce`;
                
                let reliabilityBadge = '';
                if (signal.reliability >= 80) {
                    reliabilityBadge = '<span class="reliability-badge high-reliability">YÜKSEK</span>';
                } else if (signal.reliability >= 60) {
                    reliabilityBadge = '<span class="reliability-badge medium-reliability">ORTA</span>';
                } else {
                    reliabilityBadge = '<span class="reliability-badge low-reliability">DÜŞÜK</span>';
                }
                
                signalDiv.innerHTML = `
                    <div>
                        <div style="font-weight: bold; font-size: 1.1rem;">
                            ${signal.type.includes('AL') ? '🟢 AL' : '🔴 SAT'} - ${signal.strength}
                            ${reliabilityBadge}
                        </div>
                        <div style="font-size: 0.9rem; color: var(--text-muted);">
                            ${signal.symbol} @ $${signal.price}
                            <span style="margin-left: 10px; font-size: 0.8rem;">Güvenilirlik: ${signal.reliability}%</span>
                        </div>
                    </div>
                    <div class="signal-time">${timeText}</div>
                `;
                
                container.appendChild(signalDiv);
            });
            
            updateStatistics();
        }

        function updateStatistics() {
            const todayCount = signalHistory.filter(s => {
