        // TradingView widget konfigürasyonu
        const widgetConfigs = {
            'BTCUSDT': { symbol: 'BINANCE:BTCUSDT', name: 'Bitcoin' },
            'ETHUSDT': { symbol: 'BINANCE:ETHUSDT', name: 'Ethereum' },
            'BNBUSDT': { symbol: 'BINANCE:BNBUSDT', name: 'BNB' },
            'SOLUSDT': { symbol: 'BINANCE:SOLUSDT', name: 'Solana' },
            'XRPUSDT': { symbol: 'BINANCE:XRPUSDT', name: 'Ripple' },
            'DOGEUSDT': { symbol: 'BINANCE:DOGEUSDT', name: 'Dogecoin' },
            'ADAUSDT': { symbol: 'BINANCE:ADAUSDT', name: 'Cardano' },
            'AVAXUSDT': { symbol: 'BINANCE:AVAXUSDT', name: 'Avalanche' }
        };

        // ==================== GERÇEK ZAMANLI PİYASA VERİLERİ ====================
        async function fetchMarketData() {
            try {
                // Binance API'den gerçek veri çekme
                const symbols = ['BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT', 'XRPUSDT', 'DOGEUSDT', 'ADAUSDT', 'AVAXUSDT'];
                
                for (const symbol of symbols) {
                    try {
                        const response = await fetch(`https://api.binance.com/api/v3/ticker/24hr?symbol=${symbol}`);
                        if (response.ok) {
                            const data = await response.json();
                            
                            marketData[symbol].price = parseFloat(data.lastPrice);
                            marketData[symbol].change = parseFloat(data.priceChangePercent);
                            marketData[symbol].high = parseFloat(data.highPrice);
                            marketData[symbol].low = parseFloat(data.lowPrice);
                            marketData[symbol].volume = parseFloat(data.volume);
                            
                            // Bağlantı durumunu güncelle
                            updateConnectionStatus(true);
                        }
                    } catch (e) {
                        console.log(`${symbol} verisi alınamadı:`, e);
                        // Gerçek veri alınamazsa simüle et
                        simulateMarketMovement(symbol);
                        updateConnectionStatus(false);
                    }
                }
                
                // Seçili coin'in verilerini güncelle
                updateSelectedCoinData();
                
                // Piyasa genel görünümünü güncelle
                updateMarketOverview();
                
                return true;
            } catch (error) {
                console.log('Piyasa verileri alınamadı:', error);
                updateConnectionStatus(false);
                return false;
            }
        }

        function simulateMarketMovement(symbol) {
            const current = marketData[symbol].price || initialPrices[symbol];
            const changePercent = (Math.random() * 6 - 3); // -3% ile +3% arası
            const changeAmount = current * (changePercent / 100);
            
            marketData[symbol].price = current + changeAmount;
            marketData[symbol].change = changePercent;
            marketData[symbol].high = marketData[symbol].price * (1 + Math.random() * 0.02);
            marketData[symbol].low = marketData[symbol].price * (1 - Math.random() * 0.02);
            marketData[symbol].volume = (Math.random() * 1000000 + 500000).toFixed(0);
        }

        function updateSelectedCoinData() {
            const data = marketData[selectedSymbol];
            currentPrice = data.price;
            priceChange = data.change;
            
            document.getElementById('currentPrice').textContent = `$${currentPrice.toFixed(2)}`;
            
            const changeElement = document.getElementById('priceChange');
            changeElement.textContent = `${priceChange >= 0 ? '+' : ''}${priceChange.toFixed(2)}%`;
            changeElement.className = `price-change ${priceChange >= 0 ? 'positive' : 'negative'}`;
            
            document.getElementById('high24h').textContent = `$${data.high.toFixed(2)}`;
            document.getElementById('low24h').textContent = `$${data.low.toFixed(2)}`;
            document.getElementById('volume24h').textContent = `$${(data.volume / 1000000).toFixed(1)}M`;
            
            // Güncelleme zamanı
            lastUpdateTime = new Date();
            const timeString = lastUpdateTime.toLocaleTimeString('tr-TR', { 
                hour: '2-digit', 
                minute: '2-digit',
                second: '2-digit'
            });
            document.getElementById('priceUpdateTime').textContent = `Güncelleme: ${timeString}`;
            document.getElementById('lastUpdateTime').textContent = 
                `Son güncelleme: ${lastUpdateTime.toLocaleTimeString('tr-TR')}`;
        }

        function updateMarketOverview() {
            const container = document.getElementById('marketOverview');
            container.innerHTML = '';
            
            const symbols = ['BTCUSDT', 'ETHUSDT', 'BNBUSDT', 'SOLUSDT'];
            
            symbols.forEach(symbol => {
                const data = marketData[symbol];
                const marketCard = document.createElement('div');
                marketCard.className = `market-card ${data.change >= 0 ? 'positive' : 'negative'}`;
                
                marketCard.innerHTML = `
                    <div class="market-symbol">${data.symbol}/USDT</div>
                    <div class="market-price">$${data.price.toFixed(2)}</div>
                    <div class="market-change ${data.change >= 0 ? 'positive' : 'negative'}">
                        ${data.change >= 0 ? '+' : ''}${data.change.toFixed(2)}%
                    </div>
                `;
                
                container.appendChild(marketCard);
            });
        }

        function updateConnectionStatus(isConnected) {
            const statusElement = document.getElementById('connectionStatus');
            if (isConnected) {
                statusElement.innerHTML = '<span class="status-dot status-online"></span> Bağlantı: <strong>STABİL</strong>';
                document.getElementById('dataSource').textContent = "Binance API";
                document.getElementById('dataSource').style.background = "#475569";
            } else {
                statusElement.innerHTML = '<span class="status-dot status-warning"></span> Bağlantı: <strong>SİMÜLASYON</strong>';
                document.getElementById('dataSource').textContent = "Simülasyon";
                document.getElementById('dataSource').style.background = "#f59e0b";
            }
        }

        // ==================== HABER SİSTEMİ ====================
        function startNewsFeed() {
            if (newsInterval) clearInterval(newsInterval);
            
            newsInterval = setInterval(() => {
                if (!isNewsPaused && newsActive) {
                    addRandomNews();
                }
            }, 45000); // 45 saniyede bir yeni haber
            
            // İlk haberleri ekle
            setTimeout(() => {
                if (newsActive) {
                    addInitialNews();
                }
            }, 3000);
        }

        function addInitialNews() {
            const initialNews = getNewsByCategory('regulation', 2);
            initialNews.forEach(news => {
                addNewsToFeed(news);
            });
        }

        function addRandomNews() {
            const categories = ['regulation', 'btc', 'eth', 'economy', 'security', 'investment'];
            const randomCategory = categories[Math.floor(Math.random() * categories.length)];
            const newsList = getNewsByCategory(randomCategory, 1);
            
            if (newsList.length > 0) {
                addNewsToFeed(newsList[0]);
            }
        }

        function getNewsByCategory(category, count = 1) {
            const newsDatabase = getNewsDatabase();
            const filteredNews = newsDatabase.filter(news => news.category === category);
            
            const shuffled = [...filteredNews].sort(() => 0.5 - Math.random());
            return shuffled.slice(0, count);
        }

        function addNewsToFeed(news) {
            if (!newsActive) return;
            
            const chatBox = document.getElementById('chatMessages');
            const newsDiv = createNewsElement(news);
            
            // Haberi EN ALTA ekle (yeni haberler aşağıya)
            chatBox.appendChild(newsDiv);
            
            // Haber geçmişine ekle
            const newsWithTime = {
                ...news,
                timestamp: new Date(),
                timeString: new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })
            };
            newsHistory.unshift(newsWithTime);
            
            // İstatistikleri güncelle
            updateNewsStatistics(news);
            
            // Kritik haberler için bildirim göster (5 dakikada bir maksimum)
            const now = Date.now();
            if (news.impact === 'high' && now - lastNotificationTime > 300000) {
                showNewsNotification(news);
                lastNotificationTime = now;
                
                // Kritik haberler için özel alarm sesi
                playCriticalAlarm();
            }
            
            // Haber sayısını sınırla (max 20)
            if (newsHistory.length > 20) {
                newsHistory.pop();
            }
            
            // Haber sayısını güncelle
            updateNewsCount();
            
            // Otomatik scroll aşağıya
            setTimeout(() => {
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 100);
        }

        function showNewsNotification(news) {
            const notification = document.getElementById('notification');
            const notificationText = document.getElementById('notificationText');
            
            notificationText.textContent = `${news.source}: ${news.title.substring(0, 50)}...`;
            notification.style.display = 'block';
            notification.className = 'notification-badge';
            
            // 8 saniye sonra bildirimi gizle
            setTimeout(() => {
                notification.style.display = 'none';
            }, 8000);
        }

        function updateNewsStatistics(news) {
            newsStatistics.total++;
            
            if (news.impact === 'high') newsStatistics.critical++;
            if (news.impact === 'medium') newsStatistics.important++;
            if (news.impact === 'low') newsStatistics.normal++;
            
            // Son 24 saat kontrolü
            const now = new Date();
            const last24h = newsHistory.filter(n => {
                const diffHours = (now - n.timestamp) / (1000 * 60 * 60);
                return diffHours <= 24;
            }).length;
            newsStatistics.last24h = last24h;
            
            // İstatistikleri görüntüle
            document.getElementById('last24hNews').textContent = last24h;
            document.getElementById('criticalNews').textContent = newsStatistics.critical;
            document.getElementById('importantNews').textContent = newsStatistics.important;
            
            // Son haber zamanı
            document.getElementById('lastNewsTime').textContent = 
                newsHistory.length > 0 ? newsHistory[0].timeString : '-';
        }

        function updateNewsCount() {
            const filter = document.getElementById('newsFilter').value;
            let count = 0;
            
            if (filter === 'all') count = newsHistory.length;
            else if (filter === 'critical') count = newsStatistics.critical;
            else if (filter === 'important') count = newsStatistics.important;
            else if (filter === 'normal') count = newsStatistics.normal;
            else {
                count = newsHistory.filter(n => n.category === filter).length;
            }
            
            document.getElementById('newsCount').textContent = `${count} haber`;
        }

        function filterNews() {
            const filter = document.getElementById('newsFilter').value;
            const chatBox = document.getElementById('chatMessages');
            
            // Tüm haberleri temizle (ilk 2 mesaj hariç)
            while (chatBox.children.length > 2) {
                chatBox.removeChild(chatBox.lastChild);
            }
            
            // Filtrelenmiş haberleri ekle
            let filteredNews = [];
            if (filter === 'all') {
                filteredNews = newsHistory;
            } else if (filter === 'critical') {
                filteredNews = newsHistory.filter(n => n.impact === 'high');
            } else if (filter === 'important') {
                filteredNews = newsHistory.filter(n => n.impact === 'medium');
            } else if (filter === 'normal') {
                filteredNews = newsHistory.filter(n => n.impact === 'low');
            } else {
                filteredNews = newsHistory.filter(n => n.category === filter);
            }
            
            // Filtrelenmiş haberleri ekle (tersten sırala)
            filteredNews.reverse().forEach(news => {
                const newsDiv = createNewsElement(news);
                chatBox.appendChild(newsDiv);
            });
            
            updateNewsCount();
        }

        function createNewsElement(news) {
            const newsDiv = document.createElement('div');
            
            let newsClass = 'news-normal';
            if (news.impact === 'high') newsClass = 'news-critical';
            if (news.impact === 'medium') newsClass = 'news-important';
            
            let impactLabel = 'DÜŞÜK ETKİ';
            let impactClass = 'impact-low';
            if (news.impact === 'high') {
                impactLabel = 'YÜKSEK ETKİ';
                impactClass = 'impact-high';
            } else if (news.impact === 'medium') {
                impactLabel = 'ORTA ETKİ';
                impactClass = 'impact-medium';
            }
            
            let sentimentIcon = '📊';
            if (news.sentiment === 'positive') sentimentIcon = '📈';
            if (news.sentiment === 'negative') sentimentIcon = '📉';
            
            const timeString = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
            
            newsDiv.className = `news-message ${newsClass}`;
            newsDiv.innerHTML = `
                <div class="news-header">
                    <div class="news-source">${sentimentIcon} ${news.source}</div>
                    <div class="news-time">${timeString}</div>
                </div>
                <div class="news-title">${news.title}</div>
                <div style="font-size: 0.9rem; color: #cbd5e1; margin-top: 5px;">${news.summary}</div>
                <div style="margin-top: 8px;">
                    <span class="news-impact ${impactClass}">${impactLabel}</span>
                    <span style="margin-left: 10px; font-size: 0.8rem; color: #94a3b8;">
                        İlgili: ${news.coins.join(', ')}
                    </span>
                </div>
            `;
            
            return newsDiv;
        }

        // ==================== ALARM SESLERİ ====================
        function playCriticalAlarm() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                
                // Kritik alarm sesi (daha acil)
                for (let i = 0; i < 3; i++) {
                    setTimeout(() => {
                        const oscillator = audioContext.createOscillator();
                        const gainNode = audioContext.createGain();
                        
                        oscillator.connect(gainNode);
                        gainNode.connect(audioContext.destination);
                        
                        oscillator.frequency.value = 1200; // Daha yüksek frekans
                        oscillator.type = 'sawtooth'; // Daha keskin ses
                        
                        gainNode.gain.setValueAtTime(0.5, audioContext.currentTime);
                        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                        
                        oscillator.start(audioContext.currentTime);
                        oscillator.stop(audioContext.currentTime + 0.3);
                    }, i * 400);
                }
            } catch (e) {
                console.log('Kritik alarm sesi çalınamadı:', e);
            }
        }

        function playSignalAlarm(isBuy = true) {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                
                // Sinyal alarm sesi (daha yumuşak)
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.value = isBuy ? 800 : 600; // AL için daha yüksek, SAT için daha düşük
                oscillator.type = 'sine';
                
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.8);
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.8);
            } catch (e) {
                console.log('Sinyal alarm sesi çalınamadı:', e);
            }
        }

        // ==================== SİNYAL SİSTEMİ ====================
        function generateRealisticSignal() {
            if (!alarmsActive) return;
            
            // Sadece %10 ihtimalle sinyal üret (daha nadir)
            if (Math.random() > 0.1) return;
            
            const rsi = parseFloat(document.getElementById('rsiValue').textContent) || 50;
            const stoch = parseFloat(document.getElementById('stochValue').textContent) || 50;
            const macd = parseFloat(document.getElementById('macdValue').textContent) || 0;
            
            let signalType = 'NÖTR';
            let strength = 'ORTA';
            
            // Gerçekçi sinyal üretimi
            if (rsi < 30 && stoch < 20 && macd > 0) {
                signalType = 'GÜÇLÜ AL';
                strength = 'ÇOK GÜÇLÜ';
            } else if (rsi > 70 && stoch > 80 && macd < 0) {
                signalType = 'GÜÇLÜ SAT';
                strength = 'ÇOK GÜÇLÜ';
            } else if (rsi < 35 && macd > 20) {
                signalType = 'AL';
                strength = 'GÜÇLÜ';
            } else if (rsi > 65 && macd < -20) {
                signalType = 'SAT';
                strength = 'GÜÇLÜ';
            } else {
                return; // Zayıf sinyalleri gösterme
            }
            
            const reliability = calculateSignalReliability(rsi, stoch, macd);
            
            const signal = {
                id: Date.now(),
                type: signalType,
                strength: strength,
                symbol: selectedSymbol,
                price: currentPrice.toFixed(2),
                time: new Date().toLocaleTimeString('tr-TR'),
                timestamp: new Date(),
                reliability: reliability,
                indicators: { rsi, stoch, macd }
            };
            
            signalHistory.unshift(signal);
            if (signalHistory.length > 8) signalHistory.pop();
            
            // Güvenilirlik verilerini güncelle
            updateReliabilityData(signal);
            
            // Aktif sinyalleri güncelle
            updateActiveSignals();
            
            // Sadece AL/SAT sinyalleri için bildirim göster
            if (signalType.includes('AL') || signalType.includes('SAT')) {
                triggerSignalNotification(signal);
            }
        }

        function triggerSignalNotification(signal) {
            const now = Date.now();
            // Sinyal bildirimleri arasında en az 2 dakika beklet
            if (now - lastNotificationTime < 120000) return;
            
            const notification = document.getElementById('notification');
            const notificationText = document.getElementById('notificationText');
            
            notificationText.innerHTML = `
                <strong>${signal.type.includes('AL') ? '🟢 AL' : '🔴 SAT'} SİNYALİ</strong><br>
                ${signal.symbol} @ $${signal.price}<br>
                Güç: ${signal.strength} | Güvenilirlik: ${signal.reliability}%
            `;
            
            notification.style.display = 'block';
            notification.className = `notification-badge ${signal.type.includes('AL') ? 'success' : ''}`;
            
            // Sinyal alarm sesi çal
            playSignalAlarm(signal.type.includes('AL'));
            
            // Sohbete sinyal mesajı ekle
            addSignalAlert(signal);
            
            // 10 saniye sonra bildirimi gizle
            setTimeout(() => {
                notification.style.display = 'none';
            }, 10000);
            
            lastNotificationTime = now;
        }

        function addSignalAlert(signal) {
            const chatBox = document.getElementById('chatMessages');
            const alertDiv = document.createElement('div');
            
