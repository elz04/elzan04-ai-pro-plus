<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELZAN04 AI PRO PLUS - Gelişmiş Trading Panel</title>
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #1e40af;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --bg-dark: #0f172a;
            --bg-card: #1e293b;
            --text-light: #e2e8f0;
            --text-muted: #94a3b8;
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        
        body {
            background: var(--bg-dark);
            color: var(--text-light);
            padding: 20px;
            min-height: 100vh;
        }
        
        .header {
            text-align: center;
            padding: 25px;
            background: linear-gradient(135deg, var(--primary-dark), #3730a3);
            border-radius: 20px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }
        
        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
            animation: pulse 4s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.3; }
        }
        
        .header h1 { 
            font-size: 2.5rem; 
            margin-bottom: 10px; 
            color: white;
            position: relative;
            z-index: 1;
        }
        
        .header p { 
            font-size: 1.1rem; 
            color: rgba(255, 255, 255, 0.9);
            max-width: 800px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }
        
        .control-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--bg-card);
            padding: 20px;
            border-radius: 15px;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 15px;
            border: 1px solid #334155;
        }
        
        .coin-selector select {
            background: #334155;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
            min-width: 200px;
            transition: all 0.3s;
        }
        
        .coin-selector select:hover {
            background: #475569;
            transform: translateY(-2px);
        }
        
        .alarm-controls button {
            background: var(--warning);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
            margin-left: 10px;
            transition: all 0.3s;
        }
        
        .alarm-controls button:hover {
            background: #d97706;
            transform: translateY(-2px);
        }
        
        .main-dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }
        
        .dashboard-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
            border: 1px solid #334155;
            transition: transform 0.3s;
        }
        
        .dashboard-card:hover {
            transform: translateY(-5px);
        }
        
        .dashboard-card h2 {
            color: var(--primary);
            margin-bottom: 20px;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 2px solid #334155;
            padding-bottom: 10px;
        }
        
        .price-display {
            text-align: center;
            background: linear-gradient(135deg, #1e3a8a, #3730a3);
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }
        
        .current-price {
            font-size: 3.5rem;
            font-weight: bold;
            margin: 10px 0;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
        }
        
        .price-change {
            font-size: 1.2rem;
            font-weight: bold;
            padding: 8px 20px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 10px;
        }
        
        .positive { background: var(--success); color: white; }
        .negative { background: var(--danger); color: white; }
        
        .signal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .signal-card {
            background: #0f172a;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            transition: all 0.3s;
            border: 1px solid #334155;
            cursor: pointer;
        }
        
        .signal-card:hover {
            background: #1e293b;
            border-color: var(--primary);
        }
        
        .signal-card.active {
            border-color: var(--success);
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
        }
        
        .signal-type {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: var(--text-muted);
        }
        
        .signal-value {
            font-size: 1.8rem;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .signal-status {
            font-size: 0.9rem;
            padding: 4px 12px;
            border-radius: 12px;
            display: inline-block;
        }
        
        .active-signals {
            max-height: 400px;
            overflow-y: auto;
        }
        
        .signal-item {
            background: #0f172a;
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 12px;
            border-left: 4px solid var(--primary);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }
        
        .signal-item.buy { border-left-color: var(--success); }
        .signal-item.sell { border-left-color: var(--danger); }
        
        .signal-item:hover {
            transform: translateX(5px);
            background: #1e293b;
        }
        
        .signal-time {
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        
        .chat-container {
            height: 500px;
            display: flex;
            flex-direction: column;
        }
        
        #chatMessages {
            flex-grow: 1;
            overflow-y: auto;
            padding: 15px;
            background: #0f172a;
            border-radius: 12px;
            margin-bottom: 15px;
            border: 1px solid #334155;
        }
        
        .message {
            margin-bottom: 15px;
            padding: 12px 18px;
            border-radius: 15px;
            max-width: 100%;
            word-wrap: break-word;
            animation: fadeIn 0.5s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .news-message {
            background: linear-gradient(135deg, #1e293b, #334155);
            color: white;
            border-left: 4px solid var(--primary);
            margin: 10px 0;
            padding: 15px;
            border-radius: 10px;
            animation: slideInUp 0.5s;
        }
        
        @keyframes slideInUp {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        
        .news-critical {
            background: linear-gradient(135deg, #7c2d12, #9a3412);
            border-left-color: #ea580c;
            animation: pulseCritical 2s infinite;
        }
        
        @keyframes pulseCritical {
            0%, 100% { box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.4); }
            50% { box-shadow: 0 0 0 10px rgba(234, 88, 12, 0); }
        }
        
        .news-important {
            background: linear-gradient(135deg, #374151, #4b5563);
            border-left-color: #f59e0b;
        }
        
        .news-normal {
            background: linear-gradient(135deg, #1f2937, #374151);
            border-left-color: #3b82f6;
        }
        
        .news-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }
        
        .news-source {
            font-weight: bold;
            color: var(--primary);
            font-size: 0.9rem;
        }
        
        .news-time {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        
        .news-title {
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 1rem;
        }
        
        .news-impact {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: bold;
            margin-top: 8px;
        }
        
        .impact-high { background: #ef4444; color: white; }
        .impact-medium { background: #f59e0b; color: white; }
        .impact-low { background: #3b82f6; color: white; }
        
        .alert-message {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            text-align: center;
            padding: 10px;
            border-radius: 10px;
            margin: 10px 0;
            animation: alertPulse 2s infinite;
        }
        
        .signal-alert {
            background: linear-gradient(135deg, var(--success), #059669);
            color: white;
            text-align: center;
            padding: 10px;
            border-radius: 10px;
            margin: 10px 0;
            border-left: 4px solid #10b981;
            animation: signalPulse 1.5s infinite;
        }
        
        .signal-alert.sell {
            background: linear-gradient(135deg, var(--danger), #dc2626);
            border-left-color: #ef4444;
        }
        
        @keyframes signalPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }
        
        @keyframes alertPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }
        
        .chat-input-container {
            display: none;
        }
        
        #sendBtn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0 30px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
        }
        
        #sendBtn:hover {
            background: var(--primary-dark);
            transform: scale(1.05);
        }
        
        .notification-badge {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--danger);
            color: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(239, 68, 68, 0.3);
            cursor: pointer;
            z-index: 1000;
            display: none;
            animation: slideIn 0.5s;
            max-width: 350px;
        }
        
        .notification-badge.success {
            background: var(--success);
            box-shadow: 0 5px 20px rgba(16, 185, 129, 0.3);
        }
        
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        .alarm-active {
            animation: alarmFlash 1s infinite;
        }
        
        @keyframes alarmFlash {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        }
        
        @media (max-width: 768px) {
            .main-dashboard { grid-template-columns: 1fr; }
            .control-bar { flex-direction: column; align-items: stretch; }
            .header h1 { font-size: 2rem; }
            .notification-badge { max-width: 300px; right: 15px; bottom: 15px; }
        }
        
        .tradingview-widget-container {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            overflow: hidden;
        }
        
        .alarm-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1001;
            justify-content: center;
            align-items: center;
        }
        
        .alarm-content {
            background: var(--bg-card);
            padding: 30px;
            border-radius: 20px;
            max-width: 500px;
            width: 90%;
            border: 2px solid var(--warning);
            animation: modalAppear 0.3s;
        }
        
        @keyframes modalAppear {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        
        .reliability-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: bold;
            margin-left: 10px;
        }
        
        .high-reliability { background: var(--success); }
        .medium-reliability { background: var(--warning); }
        .low-reliability { background: var(--danger); }
        
        .news-controls {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        
        .news-controls button {
            background: #475569;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        
        .news-controls button:hover {
            background: #3b82f6;
        }
        
        .news-filter {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }
        
        .news-filter select {
            background: #334155;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 8px;
            font-size: 0.9rem;
        }
        
        .market-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }
        
        .market-card {
            background: #0f172a;
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid #3b82f6;
            transition: all 0.3s;
        }
        
        .market-card:hover {
            transform: translateY(-3px);
            background: #1e293b;
        }
        
        .market-card.positive { border-left-color: var(--success); }
        .market-card.negative { border-left-color: var(--danger); }
        
        .market-symbol {
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .market-price {
            font-size: 1.3rem;
            font-weight: bold;
            margin-bottom: 5px;
        }
        
        .market-change {
            font-size: 0.9rem;
            padding: 3px 8px;
            border-radius: 10px;
            display: inline-block;
        }
        
        .system-status {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 15px;
            padding: 10px 15px;
            background: #0f172a;
            border-radius: 10px;
            font-size: 0.9rem;
        }
        
        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }
        
        .status-online { background: var(--success); }
        .status-warning { background: var(--warning); }
        .status-offline { background: var(--danger); }
    </style>
</head>
<body>
    <!-- Alarm Modal -->
    <div class="alarm-modal" id="alarmModal">
        <div class="alarm-content">
            <h2 style="color: var(--warning); margin-bottom: 20px;">🚨 YENİ ALARM SINYALİ</h2>
            <div id="alarmDetails">
                <!-- Alarm detayları buraya gelecek -->
            </div>
            <button onclick="closeAlarm()" style="
                background: var(--warning);
                color: white;
                border: none;
                padding: 12px 30px;
                border-radius: 10px;
                cursor: pointer;
                margin-top: 20px;
                width: 100%;
                font-weight: bold;
            ">Alarmı Kapat</button>
        </div>
    </div>

    <!-- Ana Header -->
    <div class="header">
        <h1>📰 ELZAN04 AI PRO PLUS v10</h1>
        <p>Gelişmiş Premium Sinyal Sistemi | Anlık Kripto Haberleri | Gerçek Zamanlı Piyasa Verileri</p>
        <div class="system-status">
            <div><span class="status-dot status-online"></span> Piyasa Verileri: <strong>CANLI</strong></div>
            <div><span class="status-dot status-online"></span> Haber Akışı: <strong>AKTİF</strong></div>
            <div><span class="status-dot status-online"></span> Sinyal Sistemi: <strong>AKTİF</strong></div>
            <div><span id="connectionStatus"><span class="status-dot status-online"></span> Bağlantı: <strong>STABİL</strong></span></div>
        </div>
    </div>

    <!-- Kontrol Çubuğu -->
    <div class="control-bar">
        <div class="coin-selector">
            <label for="coinSelect"><strong>Coin Seçimi:</strong></label>
            <select id="coinSelect" onchange="updateDashboard()">
                <option value="BTCUSDT">₿ BTC/USDT</option>
                <option value="ETHUSDT">Ξ ETH/USDT</option>
                <option value="BNBUSDT">⛓️ BNB/USDT</option>
                <option value="SOLUSDT">◎ SOL/USDT</option>
                <option value="XRPUSDT">✕ XRP/USDT</option>
                <option value="DOGEUSDT">Ð DOGE/USDT</option>
                <option value="ADAUSDT">₳ ADA/USDT</option>
                <option value="AVAXUSDT">🔺 AVAX/USDT</option>
            </select>
        </div>
        
        <div class="alarm-controls">
            <button onclick="testCriticalAlarm()" title="Kritik haber alarmını test et">
                🔥 Kritik Alarm Testi
            </button>
            <button onclick="testSignal()" title="Sinyal alarmını test et">
                📈 Sinyal Testi
            </button>
            <button onclick="toggleAlarms()" id="alarmToggle" title="Alarmlar aç/kapat">
                ✅ Alarmlar Aktif
            </button>
            <button onclick="toggleNews()" id="newsToggle" title="Haber akışı aç/kapat">
                📰 Haberler Aktif
            </button>
        </div>
    </div>

    <!-- Piyasa Genel Görünüm -->
    <div class="dashboard-card" style="margin-bottom: 25px;">
        <h2>🌎 PİYASA GENEL GÖRÜNÜM</h2>
        <div class="market-overview" id="marketOverview">
            <!-- Piyasa verileri buraya dinamik olarak eklenecek -->
        </div>
    </div>

    <!-- Ana Dashboard -->
    <div class="main-dashboard">
        <!-- Sol Kolon: Grafik ve Fiyat -->
        <div class="dashboard-card" style="grid-column: span 2;">
            <h2>📈 CANLI GRAFİK ANALİZ</h2>
            
            <!-- Fiyat Göstergesi -->
            <div class="price-display">
                <div style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.9);">
                    <span id="selectedCoinName">BTC/USDT</span>
                    <span id="marketStatus" style="margin-left: 15px; padding: 4px 12px; background: var(--success); border-radius: 12px; font-size: 0.9rem;">CANLI</span>
                    <span id="dataSource" style="margin-left: 10px; font-size: 0.8rem; background: #475569; padding: 3px 10px; border-radius: 8px;">Binance API</span>
                    <span id="priceUpdateTime" style="margin-left: 10px; font-size: 0.8rem; color: var(--text-muted);"></span>
                </div>
                <div class="current-price" id="currentPrice">Yükleniyor...</div>
                <div class="price-change" id="priceChange">Yükleniyor...</div>
                <div style="margin-top: 15px; font-size: 0.9rem; color: rgba(255, 255, 255, 0.8);">
                    <span>24s Yüksek: <strong id="high24h">-</strong></span>
                    <span style="margin-left: 20px;">24s Düşük: <strong id="low24h">-</strong></span>
                    <span style="margin-left: 20px;">24s Hacim: <strong id="volume24h">-</strong></span>
                </div>
            </div>
            
            <!-- TradingView Grafik -->
            <div style="height: 500px; margin-top: 20px;">
                <div class="tradingview-widget-container">
                    <div id="tradingview_chart"></div>
                </div>
            </div>
        </div>

        <!-- Sağ Üst: Sinyal Göstergeleri -->
        <div class="dashboard-card">
            <h2>📊 SİNYAL GÖSTERGELERİ</h2>
            <div class="signal-grid">
                <div class="signal-card" id="rsiSignal">
                    <div class="signal-type">RSI (14)</div>
                    <div class="signal-value" id="rsiValue">-</div>
                    <div class="signal-status" id="rsiStatus" style="background: var(--warning);">YÜKLENİYOR</div>
                </div>
                
                <div class="signal-card" id="stochSignal">
                    <div class="signal-type">STOCH K</div>
                    <div class="signal-value" id="stochValue">-</div>
                    <div class="signal-status" id="stochStatus" style="background: #3b82f6;">YÜKLENİYOR</div>
                </div>
                
                <div class="signal-card" id="macdSignal">
                    <div class="signal-type">MACD</div>
                    <div class="signal-value" id="macdValue">-</div>
                    <div class="signal-status" id="macdStatus" style="background: var(--success);">YÜKLENİYOR</div>
                </div>
                
                <div class="signal-card" id="volumeSignal">
                    <div class="signal-type">HACİM</div>
                    <div class="signal-value" id="volumeValue">-</div>
                    <div class="signal-status" id="volumeStatus" style="background: #8b5cf6;">YÜKLENİYOR</div>
                </div>
            </div>
            
            <!-- Sinyal Güç Göstergesi -->
            <div style="margin-top: 25px; padding: 20px; background: #0f172a; border-radius: 12px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                    <span>Sinyal Gücü:</span>
                    <span><strong id="signalStrength">-</strong></span>
                </div>
                <div style="height: 10px; background: #334155; border-radius: 5px; overflow: hidden;">
                    <div id="signalStrengthBar" style="height: 100%; width: 0%; background: linear-gradient(90deg, var(--success), var(--warning)); border-radius: 5px;"></div>
                </div>
                <div style="text-align: center; margin-top: 15px; font-size: 0.9rem; color: var(--text-muted);">
                    <span id="signalRecommendation">Veri yükleniyor...</span>
                </div>
            </div>
        </div>

        <!-- Sağ Alt: Aktif Sinyaller -->
        <div class="dashboard-card">
            <h2>🚀 AKTİF SİNYALLER</h2>
            <div class="active-signals" id="activeSignals">
                <!-- Sinyaller buraya dinamik olarak eklenecek -->
            </div>
            
            <!-- Sinyal İstatistikleri -->
            <div style="margin-top: 20px; padding: 15px; background: #0f172a; border-radius: 12px;">
                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <div style="font-size: 0.9rem; color: var(--text-muted);">Bugünkü Sinyaller</div>
                        <div style="font-size: 1.5rem; font-weight: bold;" id="todaySignals">0</div>
                    </div>
                    <div>
                        <div style="font-size: 0.9rem; color: var(--text-muted);">Başarı Oranı</div>
                        <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);" id="successRate">-%</div>
                    </div>
                    <div>
