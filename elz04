    <script>
        // ==================== SİSTEM DEĞİŞKENLERİ ====================
        let selectedSymbol = 'BTCUSDT';
        let alarmsActive = true;
        let newsActive = true;
        let lastSignalTime = new Date();
        let lastNotificationTime = 0;
        let signalHistory = [];
        let newsHistory = [];
        let currentPrice = 0;
        let priceChange = 0;
        let lastUpdateTime = null;
        let reliabilityData = {
            totalSignals: 0,
            successfulSignals: 0,
            reliabilityScore: 0,
            lastUpdated: null
        };
        
        let newsInterval = null;
        let isNewsPaused = false;
        let newsStatistics = {
            total: 0,
            critical: 0,
            important: 0,
            normal: 0,
            last24h: 0
        };

        // Güncel piyasa verileri (gerçek zamanlı güncellenecek)
        const marketData = {
            'BTCUSDT': { name: 'Bitcoin', symbol: 'BTC', price: 0, change: 0, high: 0, low: 0, volume: 0 },
            'ETHUSDT': { name: 'Ethereum', symbol: 'ETH', price: 0, change: 0, high: 0, low: 0, volume: 0 },
